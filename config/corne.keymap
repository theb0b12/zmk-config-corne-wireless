#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/36.h"                                      // Source key-labels.

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  // Left-hand keys.
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // Right-hand keys.
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      // Thumb keys.

/ {
    behaviors {
        /* Left-hand HRMs. */

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        /* Right-hand HRMs. */

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        sh: sticky_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "SH";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        par1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <3 4>;
            layers = <0>;
        };

        par2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
            layers = <0>;
        };

        cur1 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            layers = <0>;
        };

        cur2 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <31 32>;
            layers = <0>;
        };

        bracket1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <15 16>;
            layers = <0>;
        };

        bracket2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <20 19>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
            layers = <0>;
        };

        quotes {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <22 21>;
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <19 20 21>;
            layers = <0>;
        };

        lower {
            bindings = <&mo 1>;
            key-positions = <32 33 31>;
            layers = <0>;
        };

        shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <14 15 16>;
            layers = <0>;
        };

        alt {
            bindings = <&kp LALT>;
            key-positions = <28 27 26>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&trans  &kp Q  &kp W         &kp E     &kp R        &kp T            &kp Y      &kp U           &kp I      &kp O    &kp P     &trans
&trans  &kp A  &hml LCTRL S  &kp D     &kp F        &kp G            &kp H      &kp J           &kp K      &kp L    &kp SEMI  &trans
&trans  &kp Z  &kp X         &kp C     &kp V        &kp B            &kp N      &kp M           &kp COMMA  &kp DOT  &kp FSLH  &trans
                             &kp LGUI  &lt 1 ENTER  &kp BACKSPACE    &kp SPACE  &kp LEFT_SHIFT  &sh 0 2
            >;
        };

        lower {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6   &kp N7    &kp N8    &kp N9     &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &trans    &kp UP    &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
                        &trans  &trans  &trans    &kp DEL  &trans    &trans
            >;
        };

        upper {
            display-name = "Raise";
            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT     &kp CARET  &kp AMPS   &kp ASTERISK  &trans     &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR    &kp MINUS  &kp EQUAL  &kp BSLH      &kp GRAVE  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &kp UNDER  &kp PLUS   &kp PIPE      &kp TILDE  &trans  &trans
                                    &trans        &trans        &trans        &trans     &trans     &trans
            >;
        };

        fn-nav {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5         &kp F6       &kp F7    &kp F8    &kp F9     &kp F10  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &bootloader    &bootloader  &trans    &kp UP    &trans     &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans         &trans       &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &trans
                          &trans  &trans  &trans         &trans       &trans    &trans
            >;
        };
    };
};
